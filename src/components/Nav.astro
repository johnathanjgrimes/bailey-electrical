---
import biz from '../data/business.json';
import services from '../data/services.json';
const links = [
  ['/#services', 'Services'], ['/rewire-cost-cardiff/', 'Prices'], ['/rewire-quote-builder/', 'Quote Builder'],
  ['/projects/', 'Our Work'], ['/builders-trades/', 'Builders &amp; Trades'], ['/guides/', 'Guides'],
];
const svc = services.filter((s: any) => s.slug !== 'builders-trades');
---
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white text-slate-900 px-4 py-2 rounded z-[60]">Skip to content</a>
<nav class="site-nav text-white shadow-lg sticky top-0 z-50" aria-label="Main">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" aria-label={`${biz.NAME} home`}><img src="/assets/bailey-electrical-logo.svg" alt={biz.NAME} width="298" height="20" class="h-3 sm:h-4 lg:h-[18px] w-auto"></a>
      <div class="hidden lg:flex space-x-6 text-sm font-medium">
        {links.map(([h, t]) => <a href={h} class="nav-link" set:html={t} />)}
      </div>
      <div class="flex items-center gap-3">
        <a href={`tel:${biz.PHONE_TEL}`} class="hidden xl:inline-flex items-center text-sm font-semibold text-amber-400 hover:text-amber-300"><i class="fas fa-phone mr-2" aria-hidden="true"></i>{biz.PHONE_DISPLAY}</a>
        <a href="/get-a-quote/" class="cta-button text-white px-4 sm:px-5 py-2 rounded-lg font-semibold text-sm whitespace-nowrap">Get a Quote</a>
        <button id="menu-btn" class="lg:hidden text-white text-2xl px-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><i class="fas fa-bars" aria-hidden="true"></i></button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 px-4 pb-4 text-sm">
    {links.map(([h, t]) => <a href={h} class="block py-3 border-b border-slate-700 nav-link" set:html={t} />)}
    <p class="pt-4 pb-1 text-amber-400 font-semibold uppercase text-xs tracking-wide">Services</p>
    {svc.map((s: any) => <a href={`/${s.slug}/`} class="block py-3 border-b border-slate-700 nav-link" set:html={s.short} />)}
  </div>
</nav>
