---
import biz from '../data/business.json';
interface Props { kicker?: string; title: string; lead?: string; crumb?: string; image?: string; imageAlt?: string; cta?: boolean }
const { kicker, title, lead, crumb, image, imageAlt = '', cta = true } = Astro.props;
---
<header class="hero-gradient text-white py-12 md:py-20">
  <div class={`max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${image ? 'grid md:grid-cols-2 gap-10 items-center' : ''}`}>
    <div>
      {crumb && <nav aria-label="Breadcrumb" class="text-sm text-gray-400 mb-6"><a href="/" class="hover:text-amber-400">Home</a> <span class="mx-2">/</span> <span class="text-gray-200" set:html={crumb} /></nav>}
      {kicker && <p class="text-amber-400 font-semibold tracking-wide uppercase text-sm mb-3" set:html={kicker} />}
      <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight" set:html={title} />
      {lead && <p class="text-lg text-gray-300 mb-8 leading-relaxed max-w-2xl" set:html={lead} />}
      {cta && (
        <div class="flex gap-4 flex-wrap">
          <a href="/get-a-quote/" class="cta-button text-white px-8 py-3 rounded-lg font-bold text-lg">Request a Quote</a>
          <a href={`tel:${biz.PHONE_TEL}`} class="border-2 border-amber-400 text-white px-8 py-3 rounded-lg font-bold hover:bg-amber-400 hover:text-slate-900 transition"><i class="fas fa-phone mr-2" aria-hidden="true"></i>{biz.PHONE_DISPLAY}</a>
        </div>
      )}
      <slot />
    </div>
    {image && <div class="hidden md:block photo rounded-xl shadow-2xl aspect-[4/3]"><img src={image} alt={imageAlt} fetchpriority="high"></div>}
  </div>
</header>
