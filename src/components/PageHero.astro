---
import biz from '../data/business.json';
interface Props { kicker?: string; title: string; lead?: string; crumb?: string; image?: string; imageAlt?: string; cta?: boolean }
const { kicker, title, lead, crumb, image, imageAlt = '', cta = true } = Astro.props;
---
<header class={`${image ? 'photo-bg' : 'hero-gradient'} text-white`}>
  {image && <img class="bg" src={image} alt={imageAlt} fetchpriority="high">}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-14 md:pt-24 md:pb-24">
    <div class="max-w-3xl">
      {crumb && <nav aria-label="Breadcrumb" class="text-sm text-gray-400 mb-6"><a href="/" class="hover:text-amber-400">Home</a> <span class="mx-2">/</span> <span class="text-gray-200" set:html={crumb} /></nav>}
      {kicker && <p class="kicker mb-4" set:html={kicker} />}
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-[1.08]" set:html={title} />
      {lead && <p class="text-lg md:text-xl text-gray-300 mb-9 leading-relaxed max-w-2xl" set:html={lead} />}
      {cta && (
        <div class="flex gap-4 flex-wrap">
          <a href="/get-a-quote/" class="cta-button text-white px-8 py-4 font-bold text-lg">Request a Quote</a>
          <a href={`tel:${biz.PHONE_TEL}`} class="btn-ghost px-8 py-4 font-bold"><i class="fas fa-phone mr-2" aria-hidden="true"></i>{biz.PHONE_DISPLAY}</a>
        </div>
      )}
      <slot />
    </div>
  </div>
</header>
