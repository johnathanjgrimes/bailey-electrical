---
import biz from '../data/business.json';
import services from '../data/services.json';
---
<footer class="bg-slate-900 text-white py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8 pb-8 border-b border-slate-700">
      <div>
        <img src="/logo.svg" alt={biz.NAME} width="150" height="50" class="h-12 w-auto mb-4" loading="lazy">
        <p class="text-gray-400 leading-relaxed text-sm">Local, independent NICEIC registered electrician in Cardiff. Rewires, renovations, extensions, lighting and testing.</p>
      </div>
      <div>
        <h2 class="font-bold text-amber-400 mb-4">Services</h2>
        <ul class="space-y-2 text-gray-400 text-sm">
          {services.map((s: any) => <li><a href={`/${s.slug}/`} class="hover:text-amber-400" set:html={s.card_title} /></li>)}
          <li><a href="/rewire-cost-cardiff/" class="hover:text-amber-400">Rewire prices</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-bold text-amber-400 mb-4">Free tools &amp; guides</h2>
        <ul class="space-y-2 text-gray-400 text-sm mb-6">
          <li><a href="/rewire-quote-builder/" class="hover:text-amber-400">Rewire quote builder</a></li>
          <li><a href="/do-i-need-a-rewire/" class="hover:text-amber-400">Do I need a rewire?</a></li>
          <li><a href="/guides/" class="hover:text-amber-400">Guides</a></li>
          <li><a href="/projects/" class="hover:text-amber-400">Recent projects</a></li>
        </ul>
        <h2 class="font-bold text-amber-400 mb-2">Areas</h2>
        <p class="text-gray-400 text-sm leading-6">Cardiff, {biz.NEARBY_AREAS.join(', ')}</p>
      </div>
      <div>
        <h2 class="font-bold text-amber-400 mb-4">Contact</h2>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li><a href={`tel:${biz.PHONE_TEL}`} class="hover:text-amber-400"><i class="fas fa-phone mr-2" aria-hidden="true"></i>{biz.PHONE_DISPLAY}</a></li>
          <li><a href={`mailto:${biz.EMAIL}`} class="hover:text-amber-400 break-all"><i class="fas fa-envelope mr-2" aria-hidden="true"></i>{biz.EMAIL}</a></li>
          <li><a href={biz.FACEBOOK} target="_blank" rel="noopener" class="hover:text-amber-400"><i class="fab fa-facebook-f mr-2" aria-hidden="true"></i>Facebook</a></li>
          <li><i class="fas fa-location-dot mr-2" aria-hidden="true"></i>Cardiff &amp; surrounding areas</li>
        </ul>
        <a href="/get-a-quote/" class="cta-button text-white px-5 py-2 rounded-lg font-semibold text-sm mt-5">Get a quote</a>
      </div>
    </div>
    <div class="pt-8 text-center text-gray-400 text-sm">
      <p>&copy; <span id="year">{new Date().getFullYear()}</span> {biz.NAME}. NICEIC Registered. Fully insured.</p>
    </div>
  </div>
</footer>
<div class="lg:hidden fixed bottom-0 inset-x-0 z-50 grid grid-cols-2 bg-slate-900 border-t border-slate-700">
  <a href={`tel:${biz.PHONE_TEL}`} class="flex items-center justify-center gap-2 py-4 text-white font-bold"><i class="fas fa-phone text-amber-400" aria-hidden="true"></i>Call</a>
  <a href="/get-a-quote/" class="flex items-center justify-center gap-2 py-4 font-bold text-white bg-amber-600"><i class="fas fa-file-pen" aria-hidden="true"></i>Get a quote</a>
</div>
