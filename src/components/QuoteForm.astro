---
interface Props { customer?: string; job?: string; survey?: boolean; subject?: string; idPrefix?: string }
const { customer, job, survey = false, subject = 'Quote request', idPrefix = 'q' } = Astro.props;
const customers = ['Homeowner', 'Landlord / letting agent', 'Builder / trade', 'Business'];
const jobs = ['Rewire (full or partial)', 'Consumer unit upgrade', 'Extension / renovation', 'Kitchen or bathroom',
  'Lighting (indoor or outdoor)', 'EICR / landlord certificate', 'Fault finding / repair', 'Other'];
const whens = ['Within a month', '1–3 months', '3+ months / planning stage', 'Just getting prices'];
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
const id = (s: string) => `${idPrefix}-${s}`;
---
<form class="enquiry-form card rounded-xl p-6 md:p-8 grid sm:grid-cols-2 gap-5" data-subject={subject} novalidate>
  <div><label for={id('name')} class="block text-sm font-semibold mb-1">Name *</label><input id={id('name')} name="name" data-label="Name" class="field" required autocomplete="name"></div>
  <div><label for={id('phone')} class="block text-sm font-semibold mb-1">Phone *</label><input id={id('phone')} name="phone" data-label="Phone" type="tel" class="field" required autocomplete="tel"></div>
  <div><label for={id('email')} class="block text-sm font-semibold mb-1">Email</label><input id={id('email')} name="email" data-label="Email" type="email" class="field" autocomplete="email"></div>
  <div><label for={id('customer')} class="block text-sm font-semibold mb-1">I am a&hellip;</label>
    <select id={id('customer')} name="customer" data-label="Customer type" class="field">{customers.map((c) => <option selected={c === customer}>{c}</option>)}</select></div>
  <div><label for={id('job')} class="block text-sm font-semibold mb-1">Type of work</label>
    <select id={id('job')} name="job" data-label="Type of work" class="field">{jobs.map((j) => <option selected={j === job}>{j}</option>)}</select></div>
  <div><label for={id('when')} class="block text-sm font-semibold mb-1">When do you need it?</label>
    <select id={id('when')} name="when" data-label="Timescale" class="field">{whens.map((w) => <option>{w}</option>)}</select></div>
  <div class="sm:col-span-2"><label for={id('postcode')} class="block text-sm font-semibold mb-1">Job postcode *</label>
    <input id={id('postcode')} name="postcode" data-label="Postcode" class="field sm:max-w-xs" required autocomplete="postal-code" placeholder="e.g. CF14 4AA" data-postcode-check={id('area')}>
    <p id={id('area')} class="text-sm text-gray-600 mt-2" aria-live="polite"></p></div>
  {survey && (
    <fieldset class="sm:col-span-2">
      <legend class="block text-sm font-semibold mb-2">Best days for a survey visit</legend>
      <div class="flex flex-wrap gap-2">
        {days.map((d) => <label class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 cursor-pointer hover:border-amber-300"><input type="checkbox" value={d} data-label="Preferred days" class="w-4 h-4 accent-amber-500">{d}</label>)}
        {['Morning', 'Afternoon'].map((d) => <label class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 cursor-pointer hover:border-amber-300"><input type="checkbox" value={d} data-label="Preferred time" class="w-4 h-4 accent-amber-500">{d}</label>)}
      </div>
    </fieldset>
  )}
  <div class="sm:col-span-2"><label for={id('details')} class="block text-sm font-semibold mb-1">About the job *</label>
    <textarea id={id('details')} name="details" data-label="About the job" rows="5" class="field" required placeholder="e.g. 3-bed semi, full rewire and new consumer unit. Kitchen being refitted in the spring."></textarea></div>
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center gap-4">
    <button type="submit" class="cta-button text-white px-8 py-3 rounded-lg font-bold text-lg whitespace-nowrap">Send enquiry</button>
    <p class="form-msg text-sm text-gray-500" role="status">We&rsquo;ll get back to you to arrange a visit. Photos help &mdash; you can send them once we reply.</p>
  </div>
</form>
