---
import Base from '../layouts/Base.astro';
import biz from '../data/business.json';
---
<Base title="Page not found | Bailey Electrical" description="Page not found." noindex={true}>
  <section class="py-24 bg-white text-center"><div class="max-w-xl mx-auto px-4">
    <h1 class="text-5xl font-bold text-gray-900 mb-4">Page not found</h1>
    <p class="text-gray-600 mb-8">Sorry, that page doesn&rsquo;t exist. Go back to the home page or call us on {biz.PHONE_DISPLAY}.</p>
    <a href="/" class="cta-button text-white px-8 py-3 rounded-lg font-bold">Go to the home page</a>
  </div></section>
</Base>
