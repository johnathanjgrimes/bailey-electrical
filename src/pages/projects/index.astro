---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { crumbs, webPage } from '../../lib/schema';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Recent Electrical Projects in Cardiff | Bailey Electrical" description="Kitchens, bathrooms, lighting and renovation electrics completed by Bailey Electrical in and around Cardiff."
  schema={[webPage('/projects/', 'Recent projects'), crumbs([['Home', '/'], ['Projects', '/projects/']])]}>
  <PageHero crumb="Projects" kicker="Our work" image="/work-1.jpeg" title="Recent projects" lead="A few jobs we&rsquo;re proud of. Every one was planned, installed, tested and certified by us." />
  <section class="py-16 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-8">
    {projects.map((p) => (
      <a href={`/projects/${p.id}/`} class="card rounded-xl overflow-hidden block">
        <div class="photo h-64"><img src={p.data.images[0].src} alt={p.data.images[0].alt} loading="lazy"></div>
        <div class="p-6"><span class="block text-amber-600 font-semibold text-sm uppercase tracking-wide mb-2">{p.data.category}</span><span class="block text-xl font-bold text-gray-900 mb-2">{p.data.title}</span><span class="block text-gray-600 text-sm">{p.data.summary}</span></div>
      </a>
    ))}
  </div></section>
</Base>
