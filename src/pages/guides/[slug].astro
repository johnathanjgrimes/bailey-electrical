---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { getCollection, render } from 'astro:content';
import { crumbs, webPage, faqSchema, BIZ_ID, SITE } from '../../lib/schema';
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const path = `/guides/${g.id}/`;
const schema = [
  { '@type': 'Article', '@id': `${SITE}${path}#article`, headline: g.data.title, description: g.data.description, dateModified: g.data.updated.toISOString().slice(0, 10),
    datePublished: g.data.updated.toISOString().slice(0, 10), author: { '@id': BIZ_ID }, publisher: { '@id': BIZ_ID }, mainEntityOfPage: `${SITE}${path}`,
    image: g.data.image ? `${SITE}${g.data.image}` : undefined, inLanguage: 'en-GB',
    citation: g.data.sources.map((s) => s.url) },
  webPage(path, g.data.title, { about: { '@id': `${SITE}${path}#article` } }),
  crumbs([['Home', '/'], ['Guides', '/guides/'], [g.data.title, path]]),
  ...(g.data.faq.length ? [faqSchema(g.data.faq, `${SITE}${path}`)] : []),
];
const job = g.id.includes('eicr') ? 'EICR / landlord certificate' : g.id.includes('fuse') ? 'Consumer unit upgrade' : undefined;
const customer = g.id.includes('eicr') ? 'Landlord / letting agent' : undefined;
---
<Base title={g.data.seoTitle} description={g.data.description} schema={schema}>
  <PageHero crumb="Guides" kicker={g.data.kicker} image={g.data.image} title={g.data.title} lead={g.data.description} cta={false}>
    <p class="text-sm text-gray-400">Updated {g.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} &middot; Bailey Electrical, Cardiff</p>
  </PageHero>
  <div class="bg-white py-14"><div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <article class="prose-guide"><Content /></article>
    {g.data.cta && <div class="mt-10 rounded-xl bg-amber-50 border border-amber-200 p-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between"><p class="font-bold text-gray-900">Need a hand? We cover Cardiff and around 20 miles.</p><a href={g.data.cta.href} class="cta-button text-white px-6 py-3 rounded-lg font-bold">{g.data.cta.text}</a></div>}
    {g.data.sources.length > 0 && <div class="mt-10 text-sm text-gray-500"><h2 class="font-bold text-gray-700 mb-2">Sources</h2><ul class="list-disc pl-5 space-y-1">{g.data.sources.map((s) => <li><a href={s.url} class="underline" target="_blank" rel="noopener">{s.name}</a></li>)}</ul></div>}
  </div></div>
  {g.data.faq.length > 0 && <Faq faq={g.data.faq} />}
  <QuoteSection job={job} customer={customer} />
</Base>
